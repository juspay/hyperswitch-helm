# values-ocir.yaml — OCI Container Registry (OCIR) overrides for hyperswitch-stack.
#
# This file is GENERATED by oci/mirror-to-ocir.sh for the imageRegistry
# sections. Fill in the URL/ingress sections below with your actual values.
#
# Quick start:
#   1. Mirror images:
#        export OCIR_REGION=<region>           # e.g. ap-hyderabad-1
#        export OCIR_NAMESPACE=<namespace>     # from: oci os ns get
#        ./oci/mirror-to-ocir.sh
#
#   2. Fill in the three URLs below (replace <LOAD_BALANCER_IP>).
#      Use nip.io for a zero-DNS setup:
#        kubectl get svc -n ingress-nginx ingress-nginx-controller
#
#   3. Install:
#        helm install hyperswitch charts/incubator/hyperswitch-stack \
#          --namespace hyperswitch \
#          -f oci/values-ocir.yaml \
#          --wait --timeout 15m

# ── OCIR Registry ─────────────────────────────────────────────────────────────
# Set by mirror-to-ocir.sh. Format: <region>.ocir.io/<tenancy-namespace>
_ocir: &ocir "<region>.ocir.io/<tenancy-namespace>"

# ── Public URLs ───────────────────────────────────────────────────────────────
# Replace <LOAD_BALANCER_IP> with your nginx ingress controller's external IP.
# With nip.io, no DNS registration needed — sub.IP.nip.io resolves to IP.
#   Get IP: kubectl get svc -n ingress-nginx ingress-nginx-controller -o jsonpath='{.status.loadBalancer.ingress[0].ip}'
_router_url:    &router_url    "https://api.<LOAD_BALANCER_IP>.nip.io"
_sdk_url:       &sdk_url       "https://checkout.<LOAD_BALANCER_IP>.nip.io"
_dashboard_url: &dashboard_url "https://dashboard.<LOAD_BALANCER_IP>.nip.io"

# ── Stack-level service hosts (NOT propagated to sub-charts via anchors) ──────
services:
  router:
    host: *router_url
  sdk:
    host: *sdk_url

global:
  imageRegistry: *ocir

# ── hyperswitch-web ───────────────────────────────────────────────────────────
hyperswitch-web:
  autoBuild:
    buildParam:
      envBackendUrl: *router_url
      envSdkUrl: *sdk_url
  # Stack defaults to alb class (AWS-specific) — override for nginx on OKE.
  ingress:
    enabled: true
    className: "nginx"
    annotations:
      cert-manager.io/cluster-issuer: "letsencrypt-prod"
    hosts:
      - host: "checkout.<LOAD_BALANCER_IP>.nip.io"
        paths:
          - path: /
            pathType: Prefix
    tls:
      - secretName: "checkout-tls"
        hosts:
          - "checkout.<LOAD_BALANCER_IP>.nip.io"

# ── hyperswitch-app ───────────────────────────────────────────────────────────
hyperswitch-app:
  global:
    imageRegistry: *ocir

  server:
    configs:
      # user and multitenancy live under server.configs (→ ROUTER__ env vars).
      # Without these, email verification links and the API base URL default to localhost.
      user:
        base_url: *dashboard_url
      multitenancy:
        tenants:
          public:
            base_url: *router_url
            user:
              control_center_url: *dashboard_url
    ingress:
      enabled: true
      className: "nginx"
      hostname: "api.<LOAD_BALANCER_IP>.nip.io"
      annotations:
        cert-manager.io/cluster-issuer: "letsencrypt-prod"
      tls:
        - secretName: "api-tls"
          hosts:
            - "api.<LOAD_BALANCER_IP>.nip.io"

  # services must be set here (under hyperswitch-app) — YAML anchors in the
  # chart's own values.yaml are resolved at parse time, so the top-level
  # services override above has no effect on sub-chart values.
  services:
    router:
      host: *router_url
    sdk:
      host: *sdk_url

  # Vector does not use global.imageRegistry — override image.repository directly.
  # Oracle Linux 8 cri-o "short name enforcing" rejects images without a registry prefix.
  vector:
    image:
      repository: "<region>.ocir.io/<tenancy-namespace>/timberio/vector"
      tag: "0.42.0-distroless-libc"

# ── hyperswitch-control-center ────────────────────────────────────────────────
hyperswitch-control-center:
  global:
    imageRegistry: *ocir
  # YAML anchors in the chart's own values.yaml are resolved at parse time —
  # must be set explicitly here, not via top-level services override.
  dependencies:
    router:
      host: *router_url
    sdk:
      host: *sdk_url
      version: "0.129.0"
      subversion: "v1"
  env:
    default__sdkBaseUrl: *sdk_url
  ingress:
    enabled: true
    className: "nginx"
    annotations:
      cert-manager.io/cluster-issuer: "letsencrypt-prod"
    hosts:
      - host: "dashboard.<LOAD_BALANCER_IP>.nip.io"
        paths:
          - path: /
            pathType: Prefix
    tls:
      - secretName: "dashboard-tls"
        hosts:
          - "dashboard.<LOAD_BALANCER_IP>.nip.io"

# ── hyperswitch-monitoring ────────────────────────────────────────────────────
hyperswitch-monitoring:
  global:
    imageRegistry: *ocir
  # Stack defaults to alb for the monitoring ingress — override to nginx for OKE.
  ingress:
    enabled: true
    className: "nginx"
    annotations: {}
  # Disable the monitoring chart's own grafana-ingress template — it conflicts
  # with kube-prometheus-stack.grafana.ingress configured below.
  grafana:
    ingress:
      enabled: false

  # Loki does not respect global.imageRegistry — override directly.
  loki:
    image:
      registry: *ocir
      repository: grafana/loki
    # kiwigrid/k8s-sidecar has no registry prefix — short name enforcing fails on OKE.
    sidecar:
      image:
        repository: "<region>.ocir.io/<tenancy-namespace>/kiwigrid/k8s-sidecar"

  kube-prometheus-stack:
    global:
      imageRegistry: *ocir
    grafana:
      ingress:
        enabled: true
        ingressClassName: "nginx"
        annotations:
          cert-manager.io/cluster-issuer: "letsencrypt-prod"
        hosts:
          - "grafana.<LOAD_BALANCER_IP>.nip.io"
        tls:
          - secretName: "grafana-tls"
            hosts:
              - "grafana.<LOAD_BALANCER_IP>.nip.io"
      # kiwigrid/k8s-sidecar — override registry to OCIR.
      sidecar:
        image:
          registry: *ocir
          repository: kiwigrid/k8s-sidecar

# ── hyperswitch-ucs ───────────────────────────────────────────────────────────
hyperswitch-ucs:
  global:
    imageRegistry: *ocir
